# App Configuration
SECRET_KEY=dev-secret-key-change-in-production-12345
FLASK_ENV=development
PORT=5000
DATABASE_URL=sqlite:///spotmyshoot.db

# Business Details
BUSINESS_NAME=SpotMyShoot
BUSINESS_TAGLINE=Verified Shoot Spaces & Creative Studios
BUSINESS_EMAIL=contact@spotmyshoot.com
BUSINESS_PHONE=+91 98765 43210
CURRENCY=INR
CURRENCY_SYMBOL=₹
TAX_PERCENT=18

# Booking & Cancellation Policy
SLOT_HOLD_MINUTES=10
FULL_REFUND_HOURS_BEFORE=24
PARTIAL_REFUND_PERCENT=50

# Razorpay Payment Gateway (Test Mode)
# Set RAZORPAY_MOCK_MODE=True to test the complete payment flow without live API keys
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecret
RAZORPAY_MOCK_MODE=True

# Email Notifications (Gmail SMTP with App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM_NAME=SpotMyShoot Bookings
SMTP_FROM_EMAIL=your-email@gmail.com

# Optional SMS / WhatsApp Notifications via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Initial Default Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@spotmyshoot.com
